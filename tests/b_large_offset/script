if ! test -x $BADBLOCKS_SIM_EXE; then
	echo "$test_name: $test_description: skipped (no tst_badblocks_sim)"
	return 0
fi

OUT=$test_name.log
EXP=$test_dir/expect

{
	echo "=== 16T -b 4096 -r near 2^32 ==="
	$BADBLOCKS_SIM -v -b 4096 -c 64 \
		'sim:size=16T,rerr=@4294967280/4096,corrupt=@4294967290/4096' \
		4294967294 4294967275
	echo "exit status: $?"
	echo "=== 16T -b 4096 -w -t 0xaa near 2^32 ==="
	$BADBLOCKS_SIM -w -t 0xaa -v -b 4096 -c 64 \
		'sim:size=16T,rerr=@4294967280/4096,corrupt=@4294967290/4096' \
		4294967294 4294967275
	echo "exit status: $?"
	echo "=== 16T -b 4096 -n near 2^32 ==="
	$BADBLOCKS_SIM -n -S 1 -v -b 4096 -c 64 \
		'sim:size=16T,rerr=@4294967280/4096,corrupt=@4294967290/4096' \
		4294967294 4294967275
	echo "exit status: $?"
	echo "=== 4T -b 1024 -r highest 32-bit block ==="
	$BADBLOCKS_SIM -v -b 1024 -c 64 \
		'sim:size=4T,rerr=@4294967294/1024' 4294967294 4294967275
	echo "exit status: $?"
} > $OUT 2>&1

if cmp -s $OUT $EXP; then
	echo "$test_name: $test_description: ok"
	touch $test_name.ok
else
	echo "$test_name: $test_description: failed"
	diff $DIFF_OPTS $EXP $OUT > $test_name.failed
fi
unset OUT EXP
