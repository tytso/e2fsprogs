if ! test -x $BADBLOCKS_SIM_EXE; then
	echo "$test_name: $test_description: skipped (no tst_badblocks_sim)"
	return 0
fi

OUT=$test_name.log
EXP=$test_dir/expect

{
	echo "=== errmode=eio ==="
	$BADBLOCKS_SIM -w -v -b 1024 -c 16 \
		'sim:size=64K,werr=10,rerr=20,corrupt=50,errmode=eio'
	echo "exit status: $?"
	echo "=== errmode=short corrupt before rerr ==="
	$BADBLOCKS_SIM -w -v -b 1024 -c 16 \
		'sim:size=64K,corrupt=10,rerr=20,errmode=short'
	echo "exit status: $?"
} > $OUT 2>&1

if cmp -s $OUT $EXP; then
	echo "$test_name: $test_description: ok"
	touch $test_name.ok
else
	echo "$test_name: $test_description: failed"
	diff $DIFF_OPTS $EXP $OUT > $test_name.failed
fi
unset OUT EXP
