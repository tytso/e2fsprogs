if ! test -x $BADBLOCKS_SIM_EXE; then
	echo "$test_name: $test_description: skipped (no tst_badblocks_sim)"
	return 0
fi

OUT=$test_name.log
EXP=$test_dir/expect

printf "10\n" > $TMPFILE

{
	echo "=== end-of-batch rerr (errmode=eio) ==="
	$BADBLOCKS_SIM -v -b 1024 -c 16 'sim:size=64K,rerr=30,errmode=eio'
	echo "exit status: $?"
	echo "=== end-of-batch rerr (errmode=short) ==="
	$BADBLOCKS_SIM -v -b 1024 -c 16 'sim:size=64K,rerr=30,errmode=short'
	echo "exit status: $?"
	echo "=== -i clamp recovery ==="
	$BADBLOCKS_SIM -v -b 1024 -c 16 -i $TMPFILE 'sim:size=64K'
	echo "exit status: $?"
} > $OUT 2>&1

if cmp -s $OUT $EXP; then
	echo "$test_name: $test_description: ok"
	touch $test_name.ok
else
	echo "$test_name: $test_description: failed"
	diff $DIFF_OPTS $EXP $OUT > $test_name.failed
fi
unset OUT EXP
