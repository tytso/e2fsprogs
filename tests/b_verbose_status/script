if ! test -x $BADBLOCKS_SIM_EXE; then
	echo "$test_name: $test_description: skipped (no tst_badblocks_sim)"
	return 0
fi

OUT=$test_name.log
EXP=$test_dir/expect

{
	echo "=== -r -v -v ==="
	$BADBLOCKS_SIM -v -v -b 1024 -c 4 'sim:size=16K'
	echo "exit status: $?"
	echo "=== -w -t 0xaa -v -v ==="
	$BADBLOCKS_SIM -w -t 0xaa -v -v -b 1024 -c 4 'sim:size=16K'
	echo "exit status: $?"
	echo "=== -n -v -v ==="
	$BADBLOCKS_SIM -n -S 1 -v -v -b 1024 -c 4 'sim:size=16K'
	echo "exit status: $?"
	echo "=== 1-block scan 0 0 with -s ==="
	$BADBLOCKS_SIM -s -b 1024 'sim:size=16K' 0 0
	echo "exit status: $?"
} 2>&1 | tr '\010' '\n' | sed '/^$/d' > $OUT

if cmp -s $OUT $EXP; then
	echo "$test_name: $test_description: ok"
	touch $test_name.ok
else
	echo "$test_name: $test_description: failed"
	diff $DIFF_OPTS $EXP $OUT > $test_name.failed
fi
unset OUT EXP
